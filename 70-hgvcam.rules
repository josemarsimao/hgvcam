#
# hgvcam control device: lets the logged-in user (uaccess) and the video
# group create virtual cameras without root.  The player installs this file
# in /etc/udev/rules.d when it loads the module.
KERNEL=="hgvcam", SUBSYSTEM=="misc", GROUP="video", MODE="0660", TAG+="uaccess"
